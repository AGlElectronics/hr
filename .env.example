# ------------------------------------------------------------------------------
# HR module — local development environment.
# ------------------------------------------------------------------------------

APP_ENV=development
APP_BASE_URL=http://localhost:8110
HTTP_ADDR=:8110

DATABASE_URL=postgres://hr:hr@localhost:5436/hr?sslmode=disable

# Auth: use oidc against the suite Keycloak, or dev for header-only local work.
AUTH_MODE=oidc
OIDC_ISSUER_URL=http://localhost:8085/realms/conservices
OIDC_CLIENT_ID=hr-spa
OIDC_AUDIENCE=hr-spa
DEV_DEFAULT_USER=dev-hr-admin

# Real Keycloak user creation (Admin API via service account client).
KEYCLOAK_BASE_URL=http://localhost:8085
KEYCLOAK_REALM=conservices
KEYCLOAK_CLIENT_ID=hr-provisioner
KEYCLOAK_CLIENT_SECRET=hr-provisioner-dev-secret

CORS_ALLOWED_ORIGINS=http://localhost:3003

VITE_API_BASE_URL=http://localhost:8110
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=http://localhost:8085/realms/conservices
VITE_OIDC_CLIENT_ID=hr-spa
VITE_OIDC_SCOPE=openid profile email
VITE_DEV_USER=dev-hr-admin
